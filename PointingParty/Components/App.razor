<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader />

    <!-- Stamp the theme before the first paint so there is no flash of the
         wrong scheme. The system preference is only the initial value; once a
         choice is made it wins. Tailwind's dark: variant keys off the same
         attribute (see tailwind.config.js). -->
    <script>
        window.ppTheme = {
            apply: function (theme) {
                document.documentElement.setAttribute("data-theme", theme);
            },
            toggle: function () {
                var next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
                try { localStorage.setItem("pp-theme", next); } catch (e) { /* private mode */ }
                window.ppTheme.apply(next);
            }
        };
        (function () {
            var stored = null;
            try { stored = localStorage.getItem("pp-theme"); } catch (e) { /* private mode */ }
            var system = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
            window.ppTheme.apply(stored === "light" || stored === "dark" ? stored : system);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet"/>

    <link rel="stylesheet" href="@Assets["app.min.css"]" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />
    <ImportMap />
    <link rel="shortcut icon" href="/favicon.ico" sizes="any">

    <HeadOutlet/>
</head>

<body>
<Routes/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
</body>

</html>
