@using PointingParty.Domain

<button type="button" class="@CssClass" style="--pp-tint: @Tint;" aria-label="@AriaLabel"
        @onclick="@(_ => OnClick.InvokeAsync())">
    <span class="pp-card-strip"></span>
    <span class="pp-card-ring"></span>
    @if (IsScored)
    {
        @* The cactus and its spines share one box so they scale and tilt as a single plant. *@
        <span class="pp-card-plant" style="height: @(MarkHeight)px; transform: rotate(@(MarkRotation)deg);">
            <img src="/mark.svg" alt=""/>
            @foreach (var spine in Spines)
            {
                <span class="pp-spine"
                      style="left: @(spine.X)%; top: @(spine.Y)%; width: @(spine.Length)px; height: @(spine.Thickness.ToString(CultureInfo.InvariantCulture))px; transform: translateY(-50%) rotate(@(spine.Rotation)deg) scaleX(@spine.Flip);"></span>
            }
        </span>
    }
    @if (Value.Status == VoteStatus.Coffee)
    {
        <span class="pp-cup"><i></i><b></b></span>
    }
    else
    {
        <span class="pp-card-value @(Value.Status == VoteStatus.Question ? "pp-card-value-sm" : "")">@Label</span>
    }
    <span class="pp-card-caption">@Caption</span>
</button>

@code {

    [Parameter]
    public Vote Value { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private bool IsScored => Value.Status == VoteStatus.Scored;

    private string Label => Value.Status switch
    {
        VoteStatus.Scored => Value.Score.ToString(CultureInfo.InvariantCulture),
        VoteStatus.Question => "?",
        _ => ""
    };

    private string Caption => Value.Status switch
    {
        VoteStatus.Question => "not sure",
        VoteStatus.Coffee => "break",
        _ => ""
    };

    // The numerals speak for themselves; only the two utility cards need spelling out.
    private string? AriaLabel => Value.Status switch
    {
        VoteStatus.Question => "Vote not sure",
        VoteStatus.Coffee => "Vote break",
        _ => null
    };

    private string CssClass => Selected ? "pp-card pp-card-selected" : "pp-card";

    private string Tint => VoteVisuals.Tint(Value);

    private int MarkHeight => VoteVisuals.MarkHeight(Value.Score);

    private int MarkRotation => VoteVisuals.MarkRotation(Value.Score);

    private IReadOnlyList<Spine> Spines => VoteVisuals.Spines(Value.Score);

}
