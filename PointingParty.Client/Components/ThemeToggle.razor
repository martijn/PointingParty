@* Deliberately script-driven rather than a Blazor event handler: the toggle lives in statically
   rendered chrome on every page. The icon morphs between sun and moon purely from the data-theme
   attribute in CSS, so it is correct on the first paint and survives re-renders. *@
<button type="button" onclick="ppTheme.toggle()" class="pp-theme-toggle"
        aria-label="Toggle between light and dark" title="Toggle between light and dark">
    <svg class="pp-theme-icon" viewBox="0 0 24 24" aria-hidden="true">
        <mask id="pp-moon-mask">
            <rect x="0" y="0" width="100%" height="100%" fill="white"/>
            <circle cx="24" cy="10" r="6" fill="black"/>
        </mask>
        <circle class="pp-sun" cx="12" cy="12" r="6" mask="url(#pp-moon-mask)"/>
        <g class="pp-sun-beams">
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </g>
    </svg>
</button>
