@page "/Game/{gameId}"
@layout GameLayout
@using System.ComponentModel.DataAnnotations
@inject IGameContext GameContext
@inject NavigationManager NavManager
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly

<PageTitle>@GameId Pointing Party</PageTitle>

@* Folding the aggregate into the timeline on render rather than on an event: a round is only
   finished once the reset that follows it lands, and by then the votes it needs are gone. The
   call is idempotent — it acts on the reveal and the round change and ignores everything else. *@
@{ if (GameContext.Game is not null) _timeline.Observe(GameContext.Game); }

<header class="pp-header">
    <div class="pp-header-group">
        <Logo/>
        <span class="pp-pill" data-testid="game-pill">
            <span class="pp-dot @ConnectionDotClass"></span>
            <span class="pp-pill-name">@GameId</span>
            <span class="pp-pill-dot">·</span>
            <span>@ConnectionLabel</span>
        </span>
    </div>
    <div class="pp-header-group">
        @if (GameContext.Game is not null)
        {
            <span class="pp-pill">
                <span class="pp-pill-round" data-testid="round">Round @GameContext.Game.Round</span>
                <span class="pp-pill-rule"></span>
                <span>@_timeline.Clock</span>
            </span>
        }
        <ThemeToggle/>
    </div>
</header>

@if (GameContext.Game is not null)
{
    <GameUi GameContext="@GameContext" Timeline="@_timeline" GameChanged="StateHasChanged"/>
}
else
{
    <section class="pp-panel pp-join">
        <div class="pp-panel-head">
            <h1>Join <strong>@GameId</strong></h1>
        </div>

        <EditForm Model="NameForm" OnValidSubmit="CreateGame" FormName="GameData">
            <DataAnnotationsValidator/>
            <label class="pp-field">
                <span class="pp-eyebrow">Your name</span>
                <InputText @bind-Value="NameForm.Name" placeholder="Player Name" class="pp-input"/>
            </label>
            <div class="pp-actions">
                <FatButton type="submit">Enter game</FatButton>
            </div>
        </EditForm>
    </section>
}

<section class="pp-panel pp-invite">
    <div class="pp-invite-copy">
        <span class="pp-eyebrow">Invite the table</span>
        <a class="pp-invite-link" href="@GameUrl">pointingparty.com/Game/@Uri.EscapeDataString(GameId)</a>
        <span class="pp-hint">No sign-up. Open the link, pick a name, vote.</span>
    </div>
    <div class="pp-invite-qr">
        <span class="pp-invite-qr-label">Or scan<br/>to join</span>
        <QrCode GameId="@GameId"/>
    </div>
</section>

@code {

    [Parameter]
    public string GameId { get; set; } = string.Empty;

    protected class FormData
    {
        [Required]
        public string Name { get; set; } = "";
    }

    [SupplyParameterFromForm]
    protected FormData NameForm { get; set; } = new();

    [SupplyParameterFromQuery]
    public string? PlayerName { get; set; }

    private string GameUrl => $"https://pointingparty.com/Game/{Uri.EscapeDataString(GameId)}";

    private readonly RoundTimeline _timeline = new();
    private PeriodicTimer? _clock;

    private string ConnectionLabel => GameContext.Status switch
    {
        ConnectionStatus.Connected => "live",
        ConnectionStatus.Connecting => "connecting",
        _ => "offline"
    };

    private string ConnectionDotClass => GameContext.Status switch
    {
        ConnectionStatus.Connected => "",
        ConnectionStatus.Connecting => "pp-dot-warn",
        _ => "pp-dot-danger"
    };

    private void CreateGame()
    {
        GameContext.CreateGame(GameId, NameForm.Name);
    }

    private void HandleGameEvent()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await GameContext.Initialize(HandleGameEvent);
        if (string.IsNullOrWhiteSpace(PlayerName)) return;

        NameForm.Name = PlayerName;
        CreateGame();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = RunClock();

        // If game was started from the front page, remove PlayerName query string so the browser location
        // bar has a share-friendly URL
        if (GameContext.Game is not null && !string.IsNullOrWhiteSpace(PlayerName))
            NavManager.NavigateTo($"/Game/{GameId}", replace: true);
    }

    /// <summary>
    /// Drives the header clock. It only asks for a render while a round is actually running — once
    /// the votes are on the table the reading is frozen and there is nothing to repaint.
    /// </summary>
    private async Task RunClock()
    {
        _clock = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await _clock.WaitForNextTickAsync())
        {
            if (GameContext.Game is { State.ShowVotes: false })
                await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _clock?.Dispose();
        await GameContext.DisposeAsync();
    }

}
