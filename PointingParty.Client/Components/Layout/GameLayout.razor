@inherits LayoutComponentBase

@* The game screen draws its own header (game status and round live next to the
   logo), so this layout only supplies the backdrop, the shell and the footer. *@

<AmbientBackdrop/>

<div class="pp-shell">
    @Body
    <SiteFooter/>
</div>

<div id="blazor-error-ui">
    <span>An error has occurred.</span>
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
