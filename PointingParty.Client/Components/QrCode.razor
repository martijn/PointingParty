@using QRCoder
@inject NavigationManager NavManager

@if (Code is not null)
{
    <button type="button" class="pp-qr-card" @onclick="ShowModal" aria-label="Enlarge QR code">
        @* Both polarities are rendered and cross-faded by the theme tokens, the same way the
           logo swaps: the code is a baked image, so it cannot pick up a CSS variable. *@
        <span class="pp-qr-stack">
            <img class="pp-qr-dark" src="data:image/png;base64,@Code" alt="QR code to join this game"/>
            <img class="pp-qr-light" src="data:image/png;base64,@LightCode" alt=""/>
        </span>
    </button>
}

@if (_showModal)
{
    <div class="pp-qr-modal" tabindex="0" @onclick="HideModal" @onkeydown="HandleKeyDown">
        <img src="data:image/png;base64,@ModalCode" alt="QR code to join this game, enlarged"/>
    </div>
}

@code {

    // Accent modules on the theme's own ground, so the code reads as part of the card rather
    // than a pasted-in sticker. Dark is inverted (light modules on near-black); light is
    // conventional polarity. Either way the enlarged copy below is plain black-on-white, so
    // there is always a guaranteed-scannable version one tap away.
    private const string DarkThemeModules = "#4FE3A8";
    private const string DarkThemeGround = "#04100C";
    private const string LightThemeModules = "#159B6C";
    private const string LightThemeGround = "#FFFFFF";

    [Parameter]
    public string GameId { get; set; } = "";

    [PersistentState]
    public string? Code { get; set; }

    [PersistentState]
    public string? LightCode { get; set; }

    private readonly QRCodeGenerator _qrGenerator = new();
    private bool _showModal;
    private string? ModalCode { get; set; }

    protected override void OnParametersSet()
    {
        Code ??= Render(DarkThemeModules, DarkThemeGround, false);
        LightCode ??= Render(LightThemeModules, LightThemeGround, false);

        base.OnParametersSet();
    }

    private string Render(string darkColor, string lightColor, bool quietZone)
    {
        var payload = new PayloadGenerator.Url(NavManager.BaseUri.TrimEnd('/') + "/Game/" + Uri.EscapeDataString(GameId));
        // Level H keeps the inverted code readable even when a scanner struggles with polarity.
        var qrCodeData = _qrGenerator.CreateQrCode(payload.ToString(), QRCodeGenerator.ECCLevel.H);
        return new Base64QRCode(qrCodeData).GetGraphic(16, darkColor, lightColor, quietZone);
    }

    private void ShowModal()
    {
        ModalCode ??= Render("#000000", "#FFFFFF", true);
        _showModal = true;
    }

    private void HideModal()
    {
        _showModal = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            HideModal();
    }

}
