@using PointingParty.Domain
@inject IJSRuntime JS

@if (GameContext.Status != ConnectionStatus.Connected)
{
    <div class="pp-alert" role="alert">
        @if (GameContext.Status == ConnectionStatus.Connecting)
        {
            <span class="pp-dot pp-dot-warn"></span>
            <span>Connection issue detected, attempting to reconnect…</span>
        }
        else
        {
            <span class="pp-dot pp-dot-danger"></span>
            <span>Connection lost. Please reload this window to continue.</span>
        }
    </div>
}

@if (Timeline.Rounds.Count > 0)
{
    <div class="pp-timeline" data-testid="timeline">
        <span class="pp-eyebrow pp-timeline-label">This session</span>
        <span class="pp-timeline-rule"></span>
        @foreach (var round in Timeline.Rounds)
        {
            <span class="pp-timeline-chip">
                <span class="pp-timeline-median @VerdictClass(round.Verdict)" title="@VerdictLabel(round.Verdict)">@TimelineValue(round)</span>
                @* Parenthesised because Razor reads a bare R@round.Round as an email address. *@
                <span>R@(round.Round)</span>
            </span>
        }
        <span class="pp-timeline-pace">@Timeline.Pace</span>
    </div>
}

<div class="pp-grid">

    <section class="pp-panel pp-panel-deck">
        <div class="pp-panel-head pp-deck-head">
            <h1>Your estimate</h1>
            <span class="pp-hint">@DeckHint</span>
        </div>

        <div class="pp-deck-wrap">
            <div class="pp-deck">
                @foreach (var card in Deck)
                {
                    <VoteCard Value="@card"
                              Selected="@(Game.CurrentVote == card)"
                              OnClick="@(() => Vote(card))"/>
                }
            </div>
        </div>

        <div class="pp-progress">
            <div class="pp-progress-track">
                <div class="pp-progress-fill" style="width: @(VotedPercentage)%;"></div>
                @* The sweep only runs while the table is mid-vote — a full or empty bar is not waiting on anyone. *@
                @if (VotesCast > 0 && VotesCast < PlayerCount)
                {
                    <span class="pp-progress-sweep"></span>
                }
            </div>
            <span class="pp-progress-label">@VotesCast / @PlayerCount voted</span>
        </div>
    </section>

    <section class="pp-panel pp-panel-table">
        <div class="pp-panel-head">
            <h2>Around the table</h2>
            <span class="pp-hint">@TableStatus</span>
        </div>

        <div class="pp-seats" data-testid="results">
            @foreach (var (seat, index) in Players().Select((seat, index) => (seat, index)))
            {
                var (player, vote) = seat;
                var isMe = player == GameContext.PlayerName;
                var hasVoted = vote.Status != VoteStatus.Pending;
                var revealed = Game.State.ShowVotes && hasVoted;

                <div class="pp-seat" data-testid="player-row-@player">
                    @* The card is the whole state display: dashed and empty while thinking, backed
                       and ticked once in, flipped over at the reveal. *@
                    <div class="pp-seat-card @(hasVoted ? "pp-seat-in" : "") @(revealed ? "pp-seat-open" : "")"
                         style="--pp-tint: @VoteVisuals.Tint(vote); --pp-flip-delay: @(revealed ? index * 110 : 0)ms;">
                        <div class="pp-seat-flip">
                            <div class="pp-seat-back">
                                <span class="pp-seat-frame"></span>
                                <span class="pp-seat-sheen"></span>
                                <span class="pp-seat-dots"><span></span><span></span><span></span></span>
                                <img src="/mark.svg" alt="" class="pp-seat-mark"/>
                            </div>
                            <div class="pp-seat-face">
                                @* Only rendered once the round is open: an unrevealed vote must not
                                   sit in the DOM where a curious player could read it. *@
                                <span class="pp-seat-value" data-testid="vote-for-@player">@(revealed ? vote.ToString() : "")</span>
                            </div>
                        </div>
                        <span class="pp-seat-badge">✓</span>
                    </div>
                    <div class="pp-seat-label">
                        <span class="pp-avatar pp-avatar-sm @(isMe ? "pp-avatar-me" : "")"
                              style="--pp-hue: @PlayerAvatar.Hue(player);">@PlayerAvatar.Initials(player)</span>
                        <span class="pp-player-name @(isMe ? "pp-player-name-me" : "")" title="@player">@(isMe ? "you" : player)</span>
                    </div>
                    @* The card carries the state visually; this keeps it available to screen readers. *@
                    <span class="pp-sr" data-testid="state-for-@player">@(hasVoted ? "ready" : "thinking…")</span>
                </div>
            }
        </div>

        @if (Game.State.ShowVotes)
        {
            var summary = Game.State.Summarize();
            var stacks = Stacks();
            var abstained = Abstained();
            <div class="pp-reveal">
                <div class="pp-verdict-row">
                    <div>
                        <div class="pp-eyebrow">Verdict</div>
                        <div class="pp-verdict @VerdictClass(summary.Verdict)" data-testid="verdict">@VerdictLabel(summary.Verdict)</div>
                    </div>
                    <div class="pp-median">
                        <span class="pp-median-label">Median</span>
                        <span class="pp-median-value" data-testid="median">@(summary.Median?.ToString(CultureInfo.InvariantCulture) ?? "–")</span>
                    </div>
                </div>

                @* The distribution is drawn on the deck's own scale, so an empty column between two
                   busy ones reads as a gap in the table's thinking rather than as missing data. *@
                <div class="pp-scale" style="--pp-stack: @(Math.Max(1, stacks.Max(s => s.Chips.Count)) * 30)px;">
                    @foreach (var stack in stacks)
                    {
                        <div class="pp-scale-col">
                            <div class="pp-scale-stack">
                                @foreach (var (chip, position) in stack.Chips.Select((chip, position) => (chip, position)))
                                {
                                    <span class="pp-chip @(chip.IsMe ? "pp-chip-me" : "")"
                                          style="--pp-hue: @PlayerAvatar.Hue(chip.Player); animation-delay: @(300 + position * 90)ms;">
                                        <span class="pp-chip-tip">@(chip.IsMe ? $"{chip.Player} (you)" : chip.Player)</span>
                                        @PlayerAvatar.Initials(chip.Player)
                                    </span>
                                }
                            </div>
                            <span class="pp-scale-tick" style="background: @(stack.Chips.Count > 0 ? VoteVisuals.Tint(stack.Score) : "var(--border2)");"></span>
                            <span class="pp-scale-label @(stack.Chips.Count > 0 ? "" : "pp-scale-label-empty")">@stack.Score</span>
                        </div>
                    }
                </div>

                @if (abstained.Count > 0)
                {
                    <div class="pp-note">@AbstainNote(abstained)</div>
                }
            </div>
        }

        <div class="pp-actions">
            @if (Game.State.ShowVotes)
            {
                <FatButton OnClick="ClearVotes">Next story</FatButton>
            }
            else
            {
                <FatButton OnClick="ShowVotes">Reveal votes</FatButton>
                <FatButton OnClick="ClearVotes" Ghost="true">New round</FatButton>
            }
        </div>
    </section>
</div>

@code {

    private static readonly Vote[] Deck =
    [
        new(1), new(2), new(3), new(5), new(8), new(13), new(21), new(34),
        new(VoteStatus.Question), new(VoteStatus.Coffee)
    ];

    [Parameter]
    public IGameContext GameContext { get; set; } = default!;

    /// <summary>
    /// The session strip above the panels. Owned by the page, because the header's clock reads from
    /// the same timeline.
    /// </summary>
    [Parameter]
    public RoundTimeline Timeline { get; set; } = new();

    /// <summary>
    /// Raised after a local action changes the game. Remote events already re-render the page
    /// through the context's change handler, but local ones only re-render this component — and
    /// the page header shows the round number, which a local reset moves on.
    /// </summary>
    [Parameter]
    public EventCallback GameChanged { get; set; }

    private GameAggregate Game => GameContext.Game ?? new GameAggregate();

    private int PlayerCount => Game.State.PlayerVotes.Count;

    private int VotesCast => Game.State.PlayerVotes.Count(x => x.Value.Status != VoteStatus.Pending);

    private int VotedPercentage => PlayerCount == 0 ? 0 : (int)Math.Round(100.0 * VotesCast / PlayerCount);

    private string DeckHint => Game.State.ShowVotes
        ? "locked for this round"
        : Game.CurrentVote.Status == VoteStatus.Pending
            ? "tap a value"
            : "change any time until reveal";

    private string TableStatus => Game.State.ShowVotes
        ? "cards on the table"
        : VotesCast == PlayerCount && PlayerCount > 0
            ? "everyone in — ready to reveal"
            : $"waiting on {PlayerCount - VotesCast} of {PlayerCount}";

    /// <summary>
    /// The local player first — "you" should always be findable without reading — then the rest
    /// alphabetically so the roster is stable across clients.
    /// </summary>
    private IEnumerable<KeyValuePair<string, Vote>> Players()
    {
        return Game.State.PlayerVotes
            .OrderByDescending(x => x.Key == GameContext.PlayerName)
            .ThenBy(x => x.Key);
    }

    private record Chip(string Player, bool IsMe);

    private record Stack(double Score, List<Chip> Chips);

    /// <summary>
    /// One column per deck value, each holding the players who chose it. Empty columns are kept:
    /// the gaps are half the point of the picture.
    /// </summary>
    private List<Stack> Stacks()
    {
        var voters = Players()
            .Where(x => x.Value.Status == VoteStatus.Scored)
            .ToList();

        return VoteVisuals.Scale
            .Select(score => new Stack(score, voters
                .Where(x => x.Value.Score.Equals(score))
                .Select(x => new Chip(x.Key, x.Key == GameContext.PlayerName))
                .ToList()))
            .ToList();
    }

    /// <summary>
    /// Question marks and coffee cups carry no size, so they are left off the scale — but leaving
    /// them out silently would make the picture look like it lost people.
    /// </summary>
    private List<string> Abstained()
    {
        return Players()
            .Where(x => x.Value.Status is VoteStatus.Question or VoteStatus.Coffee)
            .Select(x => x.Key == GameContext.PlayerName ? "you" : x.Key)
            .ToList();
    }

    private static string AbstainNote(List<string> names)
    {
        var verb = names is ["you"] || names.Count > 1 ? "are" : "is";
        return $"{string.Join(", ", names)} {verb} sitting this one out.";
    }

    private static string VerdictLabel(Verdict verdict) => verdict switch
    {
        Verdict.Inconclusive => "Inconclusive",
        Verdict.Unanimous => "Unanimous",
        Verdict.Tight => "Tight",
        Verdict.CloseEnough => "Close enough",
        _ => "Split"
    };

    /// <summary>
    /// A round that never settled has a median, but printing it would claim the table agreed on a
    /// number it never agreed on — so the chip carries a question mark instead.
    /// </summary>
    private static string TimelineValue(TimedRound round) =>
        round.Verdict == Verdict.Inconclusive
            ? "?"
            : round.Median.ToString(CultureInfo.InvariantCulture);

    private static string VerdictClass(Verdict verdict) => verdict switch
    {
        Verdict.Inconclusive => "pp-verdict-quiet",
        Verdict.Unanimous or Verdict.Tight => "pp-verdict-tight",
        _ => "pp-verdict-split"
    };

    protected override void OnInitialized()
    {
        Game.PlayerJoined();
        GameContext.PublishEvents();
    }

    private bool _previousShowVotes;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game.State.ShowVotes && !_previousShowVotes)
        {
            _previousShowVotes = true;
            await TriggerConfettiIfUnanimous();
        }
        else if (!Game.State.ShowVotes)
        {
            _previousShowVotes = false;
        }
    }

    private static readonly string[] ConfettiShapes = ["circle", "square", "star"];
    private static readonly string[] ConfettiColors = ["#4FE3A8", "#7FB2FF", "#E9F2EC"];
    private static readonly Random Random = new();

    private async Task TriggerConfettiIfUnanimous()
    {
        if (Game.State.Summarize().Verdict == Verdict.Unanimous)
        {
            var agreed = Game.State.PlayerVotes.Values.Count(v => v.Status == VoteStatus.Scored);
            var particleCount = (int)(30 + 170 * (agreed / (double)PlayerCount));
            var shape = ConfettiShapes[Random.Next(ConfettiShapes.Length)];
            await JS.InvokeVoidAsync("confetti", new
            {
                particleCount,
                spread = 80,
                origin = new { y = 0.8 },
                shapes = new[] { shape },
                colors = ConfettiColors
            });
        }
    }

    private async Task Vote(Vote vote)
    {
        if (Game.State.ShowVotes) return;

        Game.VoteCast(vote);
        await InvokeAsync(StateHasChanged);
        GameContext.PublishEvents();
        await GameChanged.InvokeAsync();
    }

    private async Task ClearVotes()
    {
        Game.GameReset();
        GameContext.PublishEvents();
        await GameChanged.InvokeAsync();
    }

    private async Task ShowVotes()
    {
        Game.VotesShown();
        GameContext.PublishEvents();
        await GameChanged.InvokeAsync();
    }

}
